# Course version only. Use a NEW database and a dedicated Dropbox app.
POSTGRES_DB=task_management_course
POSTGRES_USER=task_management
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5433
APP_PORT=8081
# Generate at least 32 random bytes, then Base64-encode them. No runtime default.
JWT_SIGNING_KEY_BASE64=replace-with-random-base64
DROPBOX_ACCESS_TOKEN=replace-with-dropbox-token
# Recommended for long-lived use; optional with a short-lived access token.
DROPBOX_REFRESH_TOKEN=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
MAIL_FROM=tasks@example.test
